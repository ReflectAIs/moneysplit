# Server
PORT=4000
NODE_ENV=development

# Database
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=moneysplit

# Auth — MUST be a strong random secret in production
JWT_SECRET=change-me-to-a-long-random-string

# Client origin allowed by CORS
CLIENT_URL=http://localhost:5173

# SMTP (for password reset emails). Leave blank to disable email sending (dev).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
